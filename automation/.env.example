# Kopiér til .env og udfyld. .env er i .gitignore og må ALDRIG committes.

# ── Supabase ──────────────────────────────────────────────────────────────
# Service-nøglen går uden om row level security og må kun findes på den
# maskine der kører robotten. Aldrig i Flutter-appen, aldrig i git.
SUPABASE_URL=https://uaydipzotooxqisodshw.supabase.co
# Offentlig nøgle. Robotten slår kun holdenes RankedIn-link op, og
# groups er læsbar for alle — så service-nøglen er unødvendig til det.
SUPABASE_ANON_KEY=

# Kun nødvendig hvis robotten skal SKRIVE i køerne.
SUPABASE_SERVICE_ROLE_KEY=

# ── Bookli ────────────────────────────────────────────────────────────────
BOOKLI_URL=https://bookli.app/u/home
BOOKLI_LOKATION=Padel Club Hjørring
BOOKLI_EMAIL=
BOOKLI_PASSWORD=

# ── RankedIn ──────────────────────────────────────────────────────────────
RANKEDIN_URL=https://rankedin.com
RANKEDIN_USERNAME=
RANKEDIN_PASSWORD=

# ── Robotten ──────────────────────────────────────────────────────────────
# Hvor ofte køen tømmes (sekunder) når den kører i løkke.
INTERVAL_SEKUNDER=120
# Hvor mange gange en post prøves igen før den markeres som fejlet.
MAX_FORSOEG=3
# HEADLESS=0 åbner et synligt vindue — uundværligt når selektorer skal
# skrives mod en side man ikke kan se.
HEADLESS=1

# ── Broen ────────────────────────────────────────────────────────────────
# Kun 127.0.0.1. Nøglen deles med appen.
BRIDGE_PORT=8787
BRIDGE_TOKEN=
