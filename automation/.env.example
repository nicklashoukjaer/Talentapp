# Kopiér til .env og udfyld. .env må ALDRIG committes.

# Supabase — service-nøglen går uden om RLS og må kun findes på den maskine
# der kører robotten. Aldrig i Flutter-appen, aldrig i git.
SUPABASE_URL=https://uaydipzotooxqisodshw.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Bookli
BOOKLI_URL=https://bookli.app/u/home
BOOKLI_BRUGER=
BOOKLI_KODE=

# RankedIn
RANKEDIN_BRUGER=
RANKEDIN_KODE=

# Hvor ofte køen tømmes (sekunder) når robotten kører i løkke.
INTERVAL_SEKUNDER=120

# Hvor mange gange en post prøves igen før den markeres som fejlet.
MAX_FORSOEG=3
